{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["release", "revision", "release_state", "source_commit", "physical_validation_state", "safety_certification_state", "files"],
  "properties": {
    "release": {"const": "PLA-PET-Recycling-Lab-v1.0.0-rc1-FABRICATION"},
    "revision": {"const": "final-design-fabrication-closure-v0.8"},
    "release_state": {"const": "FABRICATION_CANDIDATE"},
    "physical_validation_state": {"const": "NOT_RUN"},
    "safety_certification_state": {"const": "NOT_CERTIFIED"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "source", "size", "sha256"]}}
  },
  "additionalProperties": true
}
