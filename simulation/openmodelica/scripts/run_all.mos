loadFile(getInstallationDirectoryPath()+"/share/omlibrary/libraries/Complex 4.0.0/package.mo");
loadFile(getInstallationDirectoryPath()+"/share/omlibrary/libraries/ModelicaServices 4.0.0/package.mo");
loadFile(getInstallationDirectoryPath()+"/share/omlibrary/libraries/Modelica 4.0.0/package.mo");
loadFile("simulation/openmodelica/PLA_PET_Recycler/package.mo");
cd("simulation/openmodelica/results/raw");
simulate(PLA_PET_Recycler.Scenarios.NoLoadStartStop,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="NoLoadStartStop");
simulate(PLA_PET_Recycler.Scenarios.PLANominal,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="PLANominal");
simulate(PLA_PET_Recycler.Scenarios.PETNominal,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="PETNominal");
simulate(PLA_PET_Recycler.Scenarios.SingleToothImpact,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="SingleToothImpact");
simulate(PLA_PET_Recycler.Scenarios.MultiToothEngagement,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MultiToothEngagement");
simulate(PLA_PET_Recycler.Scenarios.OneShaftJam,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="OneShaftJam");
simulate(PLA_PET_Recycler.Scenarios.MotorStall,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MotorStall");
simulate(PLA_PET_Recycler.Scenarios.JamReverseRetry,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="JamReverseRetry");
simulate(PLA_PET_Recycler.Scenarios.EmergencyStop,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="EmergencyStop");
simulate(PLA_PET_Recycler.Scenarios.InputFuseOperation,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="InputFuseOperation");
simulate(PLA_PET_Recycler.Scenarios.ChainBacklashImpact,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ChainBacklashImpact");
simulate(PLA_PET_Recycler.Scenarios.ScrewPressureRamp,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ScrewPressureRamp");
simulate(PLA_PET_Recycler.Scenarios.ScrewJam,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ScrewJam");
simulate(PLA_PET_Recycler.Scenarios.EmptySpool,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="EmptySpool");
simulate(PLA_PET_Recycler.Scenarios.HalfSpool,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="HalfSpool");
simulate(PLA_PET_Recycler.Scenarios.FullSpool,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullSpool");
simulate(PLA_PET_Recycler.Scenarios.GaugeDropout,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="GaugeDropout");
simulate(PLA_PET_Recycler.Scenarios.FullMechanicalNominal,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullMechanicalNominal");
getErrorString();
