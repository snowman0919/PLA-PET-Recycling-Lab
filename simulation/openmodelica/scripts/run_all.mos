loadFile(getInstallationDirectoryPath()+"/share/omlibrary/libraries/Complex 4.0.0/package.mo");
loadFile(getInstallationDirectoryPath()+"/share/omlibrary/libraries/ModelicaServices 4.0.0/package.mo");
loadFile(getInstallationDirectoryPath()+"/share/omlibrary/libraries/Modelica 4.0.0/package.mo");
loadFile("simulation/openmodelica/PLA_PET_Recycler/package.mo");
cd("simulation/openmodelica/results/raw");
simulate(PLA_PET_Recycler.Scenarios.MotorNoLoadStart,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MotorNoLoadStart");
simulate(PLA_PET_Recycler.Scenarios.MotorRatedLoad,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MotorRatedLoad");
simulate(PLA_PET_Recycler.Scenarios.PLANominal,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="PLANominal");
simulate(PLA_PET_Recycler.Scenarios.PETNominal,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="PETNominal");
simulate(PLA_PET_Recycler.Scenarios.SingleHookImpact,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="SingleHookImpact");
simulate(PLA_PET_Recycler.Scenarios.MultiHookEngagement,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MultiHookEngagement");
simulate(PLA_PET_Recycler.Scenarios.OneShaftJam,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="OneShaftJam");
simulate(PLA_PET_Recycler.Scenarios.FullJam,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullJam");
simulate(PLA_PET_Recycler.Scenarios.ReverseClear,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ReverseClear");
simulate(PLA_PET_Recycler.Scenarios.RetryFailure,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="RetryFailure");
simulate(PLA_PET_Recycler.Scenarios.MechanicalFuseTrip,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MechanicalFuseTrip");
simulate(PLA_PET_Recycler.Scenarios.ChainBacklashReverse,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ChainBacklashReverse");
simulate(PLA_PET_Recycler.Scenarios.EmergencyStop,startTime=0,stopTime=5,numberOfIntervals=1000,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="EmergencyStop");
simulate(PLA_PET_Recycler.Scenarios.ExtruderWarmupPLA,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ExtruderWarmupPLA");
simulate(PLA_PET_Recycler.Scenarios.ExtruderWarmupPET,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ExtruderWarmupPET");
simulate(PLA_PET_Recycler.Scenarios.ExtruderNominalPLA,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ExtruderNominalPLA");
simulate(PLA_PET_Recycler.Scenarios.ExtruderNominalPET,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ExtruderNominalPET");
simulate(PLA_PET_Recycler.Scenarios.ExtruderHighFlow,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ExtruderHighFlow");
simulate(PLA_PET_Recycler.Scenarios.ScrewJam,startTime=0,stopTime=300,numberOfIntervals=600,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="ScrewJam");
simulate(PLA_PET_Recycler.Scenarios.HeaterOpen,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="HeaterOpen");
simulate(PLA_PET_Recycler.Scenarios.SensorOpen,startTime=0,stopTime=300,numberOfIntervals=600,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="SensorOpen");
simulate(PLA_PET_Recycler.Scenarios.MOSFETStuckOn,startTime=0,stopTime=3600,numberOfIntervals=3600,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="MOSFETStuckOn");
simulate(PLA_PET_Recycler.Scenarios.EmptySpool,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="EmptySpool");
