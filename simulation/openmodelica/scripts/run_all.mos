simulate(PLA_PET_Recycler.Scenarios.SpoolJam,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="SpoolJam");
simulate(PLA_PET_Recycler.Scenarios.DancerLimit,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="DancerLimit");
simulate(PLA_PET_Recycler.Scenarios.GaugeDropout,startTime=0,stopTime=8,numberOfIntervals=800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="GaugeDropout");
simulate(PLA_PET_Recycler.Scenarios.FullSystemPLA,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullSystemPLA");
simulate(PLA_PET_Recycler.Scenarios.FullSystemPET,startTime=0,stopTime=1800,numberOfIntervals=1800,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullSystemPET");
simulate(PLA_PET_Recycler.Scenarios.FullSystemGaugeFailure,startTime=0,stopTime=300,numberOfIntervals=600,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullSystemGaugeFailure");
simulate(PLA_PET_Recycler.Scenarios.FullSystemJam,startTime=0,stopTime=300,numberOfIntervals=600,tolerance=1e-6,method="dassl",outputFormat="csv",fileNamePrefix="FullSystemJam");
getErrorString();
